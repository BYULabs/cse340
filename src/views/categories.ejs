<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Some of our Categories</h2>
    <p class="section-lead">Explore service sectors or create a new category to expand volunteer initiatives.</p>

    <!-- FLASH MESSAGES -->
    <% if (messages && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger">
            <ul class="alert-list">
                <% messages.error.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <% if (messages && messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success">
            <ul class="alert-list">
                <% messages.success.forEach(function(msg) { %>
                    <li><%= msg %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <ul class="category-grid">
        <% categories.forEach(category => { %>
            <li style="padding: 0;">
                <a href="/category/<%= category.category_id %>" style="text-decoration: none; color: inherit; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 2rem 1.5rem;">
                    <%= category.name %>
                </a>
            </li>
        <% }); %>
    </ul>

    <!-- Bottom Action Callout -->
    <% if (user && user.role_name === 'admin') { %>
        <section class="categories-bottom-action">
            <p>Don't see the sector you are looking for?</p>
            <a href="/new-category" class="btn-primary">Add New Category</a>
        </section>
    <% } %>
</main>

<%- include('partials/footer') %>