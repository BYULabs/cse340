<%- include('partials/header') %>

<main class="form-page-container">
    <h1><%= title %></h1>
    <p class="section-lead">Create your account to start joining and organizing community service projects.</p>

    <!-- FLASH MESSAGES -->
    <% if (messages && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger">
            <ul class="alert-list">
                <% messages.error.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <% if (messages && messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success">
            <ul class="alert-list">
                <% messages.success.forEach(function(msg) { %>
                    <li><%= msg %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <div class="form-card">
        <form action="/register" method="POST" class="styled-form">
            <!-- Display Name Field -->
            <div class="form-group">
                <label for="name">Full Name</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    placeholder="e.g., Alex Morgan"
                    required
                    maxlength="100"
                />
            </div>

            <!-- Email / Username Field -->
            <div class="form-group">
                <label for="email">Email Address</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="you@example.com"
                    required
                    maxlength="100"
                />
            </div>

            <!-- Password Field -->
            <div class="input-group">
            <label for="password">Password</label>
            <div class="input-wrapper">
                <input 
                type="password" 
                id="password"
                name="password" 
                placeholder="Enter your password" 
                autocomplete="current-password"
                />
            </div>
            </div>

            <!-- Form Action Buttons -->
            <div class="form-actions">
                <button type="submit" class="btn-primary full-width">Register</button>
                <a href="/" class="btn-outline full-width">Cancel</a>
            </div>
        </form>
    </div>
</main>

<%- include('partials/footer') %>