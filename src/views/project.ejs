<%- include('partials/header') %>

<main class="project-detail-container">
    <h1><%= title %></h1>

    <!-- FLASH MESSAGES -->
    <% if (messages && messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success">
            <ul class="alert-list">
                <% messages.success.forEach(function(msg) { %>
                    <li><%= msg %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <% if (messages && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger">
            <ul class="alert-list">
                <% messages.error.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <section class="project-profile-card">
        <div class="project-profile-header">
            <div class="project-profile-info">
                <h2><%= project.title %></h2>
                <div class="project-meta">
                    <% 
                        const formattedDate = new Date(project.date).toLocaleDateString(undefined, {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        });
                    %>
                    <span class="project-date">📅 <%= formattedDate %></span>
                    <span class="project-location">📍 <%= project.location %></span>
                </div>
            </div>

            <!-- Action Buttons: Edit Project & Assign Categories (Admin Only) -->
            <% if (user && user.role_name === 'admin') { %>
                <div class="project-profile-actions">
                    <a href="/edit-project/<%= project.project_id || project.id %>" class="btn-outline btn-edit-org">
                        ✏️ Edit Project
                    </a>
                    <a href="/project/<%= project.project_id || project.id %>/assign-categories" class="btn-outline btn-edit-org">
                        🏷️ Assign Categories
                    </a>
                </div>
            <% } %>
        </div>
        
        <div class="project-profile-body">
            <!-- Category Badges -->
            <% if (categories && categories.length > 0) { %>
                <div class="project-tags">
                    <% categories.forEach(category => { %>
                        <a href="/category/<%= category.category_id %>" class="hero-badge category-badge-link">
                            <%= category.name %>
                        </a>
                    <% }); %>
                </div>
            <% } %>

            <p class="project-desc"><%= project.description %></p>
            
            <div class="project-organization-reference">
                <strong>Partner Organization:</strong> 
                <a href="/organization/<%= project.organization_id %>" class="org-link">
                    <%= project.organization_name %>
                </a>
            </div>

            <!-- Volunteer Action Section (Only visible if logged in) -->
            <% if (user) { %>
                <div class="volunteer-card-section">
                    <% if (isVolunteering) { %>
                        <div class="volunteer-active-badge">
                            <span class="volunteer-status-icon">✅</span>
                            <div class="volunteer-status-text">
                                <strong>You are volunteering for this project</strong>
                                <span>Thank you for contributing your time!</span>
                            </div>
                        </div>
                        <a href="/project/<%= project.project_id || project.id %>/unvolunteer" class="btn-outline btn-danger-outline">
                            Remove yourself as a volunteer
                        </a>
                    <% } else { %>
                        <div class="volunteer-cta-block">
                            <div class="volunteer-cta-info">
                                <strong>Want to help out?</strong>
                                <span>Join other volunteers making an impact on this project.</span>
                            </div>
                            <a href="/project/<%= project.project_id || project.id %>/volunteer" class="btn-primary">
                                🙌 Volunteer for this Project
                            </a>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>