<%- include('partials/header') %>

<main class="project-detail-container">
    <h1><%= title %></h1>

    <!-- FLASH MESSAGES -->
    <% if (messages && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger">
            <ul class="alert-list">
                <% messages.error.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <% if (messages && messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success">
            <ul class="alert-list">
                <% messages.success.forEach(function(msg) { %>
                    <li><%= msg %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <!-- User Profile Card -->
    <section class="org-profile-card">
        <div class="org-profile-header">
            <div class="org-profile-info">
                <h2>Welcome back, <%= name %>!</h2>
                <span class="org-profile-email">✉️ <%= email %></span>
            </div>
            <% if (typeof user !== 'undefined' && user && user.role_name) { %>
                <div class="hero-badge" style="text-transform: uppercase;">
                    <%= user.role_name %> Account
                </div>
            <% } %>
        </div>
        <div class="org-profile-body">
            <p class="org-profile-desc">
                Manage your profile settings or access administrative control panels below.
            </p>
        </div>
    </section>

    <!-- My Volunteered Projects Section -->
    <section class="org-projects-section">
        <h3 class="section-subtitle">🙌 My Volunteer Projects</h3>

        <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
            <ul class="org-projects-grid">
                <% volunteeredProjects.forEach(project => { %>
                    <li>
                        <div>
                            <h4 class="project-card-title">
                                <a href="/project/<%= project.project_id %>">
                                    <%= project.title %>
                                </a>
                            </h4>
                            <% 
                                const formattedDate = new Date(project.project_date).toLocaleDateString(undefined, {
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric'
                                });
                            %>
                            <div class="project-meta" style="margin-bottom: 0.5rem;">
                                <span class="project-date">📅 <%= formattedDate %></span>
                                <span class="project-location">📍 <%= project.location %></span>
                            </div>
                            <p class="project-card-teaser"><%= project.description %></p>
                        </div>
                        <div class="project-card-footer" style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;">
                            <span class="org-card-email">
                                Organization: <strong><%= project.organization_name %></strong>
                            </span>
                            <a href="/project/<%= project.project_id %>/unvolunteer" class="btn-outline btn-danger-outline" style="font-size: 0.85rem; padding: 6px 12px;">
                                Remove Volunteer
                            </a>
                        </div>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <div class="no-projects-box">
                <p>You haven't signed up for any volunteer projects yet.</p>
                <a href="/projects" class="btn-primary" style="margin-top: 1rem; display: inline-block;">
                    Browse Upcoming Projects
                </a>
            </div>
        <% } %>
    </section>

    <!-- Admin Management Panel Callout -->
    <% if (typeof user !== 'undefined' && user && user.role_name === 'admin') { %>
        <section class="categories-bottom-action">
            <div>
                <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--navy-900);">Admin Management Tools</h3>
                <p style="margin-top: 0.25rem;">View and manage registered accounts across the platform.</p>
            </div>
            <a href="/users" class="btn-primary">
                👥 Manage All Users
            </a>
        </section>
    <% } %>
</main>

<%- include('partials/footer') %>