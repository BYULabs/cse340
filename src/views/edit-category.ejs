<%- include('partials/header') %>

<main class="form-page-container">
    <h1><%= title %></h1>
    <p class="section-lead">Update the category name and keep your service sectors accurate.</p>

    <!-- FLASH MESSAGES -->
    <% if (messages && messages.error && messages.error.length > 0) { %>
        <div class="alert alert-danger">
            <ul class="alert-list">
                <% messages.error.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <% if (messages && messages.success && messages.success.length > 0) { %>
        <div class="alert alert-success">
            <ul class="alert-list">
                <% messages.success.forEach(function(msg) { %>
                    <li><%= msg %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <div class="form-card">
        <form action="/edit-category/<%= category.category_id || category.id %>" method="POST" class="styled-form">
            <div class="form-group">
                <label for="name">Category Name</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    value="<%= category.name || '' %>"
                    placeholder="e.g., Environmental Conservation"
                    required
                    minlength="2"
                    maxlength="100"
                />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary full-width">Save Changes</button>
                <a href="/category/<%= category.category_id || category.id %>" class="btn-outline full-width">Cancel</a>
            </div>
        </form>
    </div>
</main>

<%- include('partials/footer') %>